<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MiniFlix</AssemblyName>
    <RootNamespace>MiniFlix</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Gerado por tools\gerar-icone.ps1 a partir de assets\icone\*.svg -->
    <ApplicationIcon>miniflix.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- Arquivo único: o .NET (≈230 DLLs) vai dentro do MiniFlix.exe, que fica fácil de achar.
         IncludeNativeLibrariesForSelfExtract=false: as poucas DLLs nativas ficam AO LADO do .exe
         em vez de serem extraídas para %TEMP% (o app não pode deixar rastros no PC). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Símbolos de depuração dentro do .exe: stack traces com linha, sem .pdb solto. -->
    <DebugType>embedded</DebugType>
    <!-- Não publica os .xml de documentação dos pacotes NuGet (inúteis para o usuário final). -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- O pacote WebView2 também referencia a DLL de WPF; o conflito de WindowsBase é inofensivo em WinForms. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MiniFlix.Tests" />
  </ItemGroup>

  <!-- Frontend (src/ui) copiado para a pasta /ui ao lado do .exe -->
  <ItemGroup>
    <Content Include="..\ui\**\*" Exclude="..\ui\css\input.css" Link="ui\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
